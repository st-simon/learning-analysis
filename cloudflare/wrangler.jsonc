{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-analysis-validation",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "REPLACE_WITH_TEST_NAMESPACE_ID"}],
  "durable_objects": {"bindings": [{"name": "ARTICLE_QUOTA", "class_name": "ArticleQuota"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ArticleQuota"]}]
}
